.cache/
.eslintcache
.parcel-cache/


# Temporary files
*.tmp
*.temp
*.bak
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Uploads (sensitive user data)
uploads/
exports/

# Prisma
prisma/*.db
prisma/*.db-journal
# The backend Prisma client is generated into backend/generated/prisma by
# `prisma generate` (typecheck, build and the Dockerfile all run it). It is
# already ignored by backend/.gitignore; it is repeated here because tools
# that only read the root ignore file (jscpd, sweeps) otherwise count ~1,300
# generated lines as duplicated source.
backend/generated/

# Secrets and credentials
*.pem
*.key
*.crt
secrets/
credentials/

# Debug
.debug/

# Per-session agent worktrees — scratch, never part of the repo.
.claude/worktrees/
